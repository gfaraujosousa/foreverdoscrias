# Build/export outputs
/builds/
/dist/
/export/
*.mrpack
*.zip

# Minecraft runtime folders
/run/
/.minecraft/
/logs/
/crash-reports/
/debug/
/saves/
/screenshots/
/backups/
/journeymap/
/xaero/
/dumps/
/replay_recordings/

# Launcher/runtime files
/options.txt
/optionsof.txt
/servers.dat
/usercache.json
/usernamecache.json
/launcher_profiles.json
/realms_persistence.json

# Downloaded/generated mod jars
/mods/*.jar

# But allow intentionally bundled private custom jars in overrides
!/overrides/mods/*.jar

# Optional: local dev-only custom jars
/local-mods/
/dev-mods/

# Packwiz temporary/cache files
/.packwiz/
/packwiz-installer-bootstrap.jar
/packwiz-installer.jar

# Java/Gradle if you build helper tools or local forks here
/.gradle/
/build/
/out/
/target/
*.class
*.log
hs_err_pid*

# IDE/editor
/.idea/
/.vscode/
*.iml
*.swp
*.swo
